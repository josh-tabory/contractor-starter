---
interface Props {
  rating?: string;
  reviewCount?: number;
}

const { rating = "5.0", reviewCount = 48 } = Astro.props;

const testimonials = [
  {
    name: "Mark T.",
    location: "Austin, TX",
    text: "Punctual, professional, and fair pricing. They transformed our space in less than two days. Highly recommend!",
    stars: 5
  },
  {
    name: "Sarah L.",
    location: "Round Rock, TX",
    text: "Called them for an urgent job. They arrived within 2 hours and fixed everything right the first time.",
    stars: 5
  },
  {
    name: "David R.",
    location: "Cedar Park, TX",
    text: "Clean work site, great communication, and honest quote. Will definitely be using them for future projects.",
    stars: 5
  }
];
---

<section class="max-w-5xl mx-auto py-12 px-6">
  <div class="bg-white rounded-2xl p-6 border border-slate-200 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4 mb-8">
    <div class="flex items-center gap-3">
      <svg class="w-8 h-8" viewBox="0 0 24 24">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
      </svg>
      <div>
        <div class="flex items-center gap-1 text-amber-500 font-bold text-lg">
          <span>{rating}</span>
          <span>★★★★★</span>
        </div>
        <p class="text-xs text-slate-500">Based on {reviewCount}+ verified Google reviews</p>
      </div>
    </div>
    <span class="text-xs font-semibold bg-emerald-100 text-emerald-800 px-3 py-1.5 rounded-full">
      ✓ Verified Local Contractor
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    {testimonials.map((t) => (
      <div class="bg-slate-900 text-white p-6 rounded-2xl shadow-sm flex flex-col justify-between">
        <div>
          <div class="text-amber-400 text-sm mb-2">★★★★★</div>
          <p class="text-slate-300 text-sm italic leading-relaxed">"{t.text}"</p>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-800 flex justify-between items-center text-xs text-slate-400">
          <span class="font-bold text-white">{t.name}</span>
          <span>{t.location}</span>
        </div>
      </div>
    ))}
  </div>
</section>