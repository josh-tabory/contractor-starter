---
import siteConfig from '../site-config.json';
---

<section id="quote" class="max-w-3xl mx-auto py-12 px-6">
  <div class="bg-white rounded-3xl p-8 border border-slate-200 shadow-xl">
    <h2 class="text-3xl font-black text-slate-950 text-center">Request a Free Estimate</h2>
    <p class="text-slate-600 text-center mt-2 text-sm">
      Fill out the form below and we will contact you within 24 hours.
    </p>

    <!-- Web3Forms Free Endpoint (Replace access_key when deploying for a client) -->
    <form 
      action="https://api.web3forms.com/submit" 
      method="POST" 
      class="mt-8 space-y-4"
    >
      <input type="hidden" name="access_key" value="YOUR_FREE_ACCESS_KEY_HERE" />
      <input type="hidden" name="subject" value={`New Quote Request - ${siteConfig.businessName}`} />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Your Name</label>
          <input 
            type="text" 
            name="name" 
            required 
            placeholder="John Doe" 
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:outline-none"
          />
        </div>

        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Phone Number</label>
          <input 
            type="tel" 
            name="phone" 
            required 
            placeholder="(555) 000-0000" 
            class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:outline-none"
          />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">Project Details</label>
        <textarea 
          name="message" 
          rows="4" 
          required 
          placeholder="Briefly describe what work you need done..." 
          class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:outline-none"
        ></textarea>
      </div>

      <button 
        type="submit" 
        class="w-full bg-slate-950 hover:bg-slate-800 text-white font-bold py-4 rounded-xl shadow-md transition text-lg"
      >
        Submit Quote Request
      </button>
    </form>
  </div>
</section>