---
import '../styles/global.css';
import siteConfig from '../site-config.json';
import MobileCallBar from '../components/MobileCallBar.astro';
import QuoteForm from '../components/QuoteForm.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description} />
    <title>{siteConfig.businessName} | {siteConfig.tagline}</title>
  </head>
  <body class="bg-slate-50 text-slate-900 antialiased font-sans">
    
    <!-- Top Contact Bar -->
    <header class="bg-slate-900 text-white py-3 px-6 flex justify-between items-center text-sm font-medium">
      <div>📍 Serving {siteConfig.city}</div>
	  <a href={`tel:${siteConfig.phone}`} 
	   aria-label={`Call ${siteConfig.businessName} at ${siteConfig.phone}`}
	   class="bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold px-4 py-1.5 rounded-full transition">
		Call Now: {siteConfig.phone}</a>
    </header>
	<main>
		<!-- Hero Section -->
		<section class="max-w-4xl mx-auto text-center py-20 px-6">
		<h1 class="text-4xl sm:text-6xl font-black tracking-tight text-slate-950">
			{siteConfig.businessName}
		</h1>
		<p class="text-xl text-slate-600 mt-4 max-w-2xl mx-auto">
			{siteConfig.tagline}
		</p>

		<div class="mt-8 flex flex-wrap justify-center gap-4">
			<a href={`tel:${siteConfig.phone}`} class="bg-blue-700 hover:bg-blue-800 text-white font-bold text-lg px-8 py-4 rounded-xl shadow-lg transition">
			Get a Free Quote
			</a>
		</div>
		</section>

		<!-- Services Grid -->
		<section class="max-w-5xl mx-auto py-12 px-6">
		<h2 class="text-2xl font-bold text-slate-900 mb-6 border-b pb-2">Our Services</h2>
		<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
			{siteConfig.services.map((service) => (
			<div class="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition">
				<h3 class="text-xl font-bold text-slate-900">{service.title}</h3>
				<p class="text-slate-600 mt-2 text-sm leading-relaxed">{service.description}</p>
			</div>
			))}
		</div>
		</section>

		<!-- Before After Slider -->
		<BeforeAfter />
		
		<!-- Quote Form Component -->
		<QuoteForm />
	</main>

    <!-- Mobile Sticky Call Bar -->
    <MobileCallBar />
  </body>
</html>